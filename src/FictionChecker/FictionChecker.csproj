<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FictionChecker</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FictionChecker.Tests" />
    <InternalsVisibleTo Include="FictionChecker.Eval" />
    <InternalsVisibleTo Include="FictionChecker.DataBuilder" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\lexicon.bin" LogicalName="FictionChecker.Data.lexicon.bin" Condition="Exists('Data\lexicon.bin')" />
    <EmbeddedResource Include="Data\wordinfo.bin" LogicalName="FictionChecker.Data.wordinfo.bin" Condition="Exists('Data\wordinfo.bin')" />
    <EmbeddedResource Include="Data\Lists\*.txt" LogicalName="FictionChecker.Data.Lists.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
